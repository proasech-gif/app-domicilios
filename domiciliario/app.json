{
  "expo": {
    "name": "Domiciliario",
    "slug": "app-domicilios-domiciliario",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FF6A00"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.domicilios.domiciliario",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite el acceso a tus fotos para subir tus documentos y tu selfie.",
          "cameraPermission": "Permite el acceso a la cámara para tomar la foto de tus documentos o tu selfie."
        }
      ]
    ],
    "scheme": "domicilios-domiciliario",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5996bbe-7ef9-43fe-83ad-c553cddccb6d"
      }
    },
    "owner": "19821974"
  }
}
